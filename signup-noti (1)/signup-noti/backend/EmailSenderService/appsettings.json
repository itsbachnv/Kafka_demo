{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Url": "amqp://guest:guest@localhost:5672",
    "Prefetch": 10
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "no-reply@example.com"
  },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelayMs": 1000
  }
}
